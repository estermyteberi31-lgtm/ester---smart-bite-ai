# Used only for native app builds (Capacitor), not the regular website.
#
# The website works with no setup because the browser page and the API
# live at the same address. The native app has no address of its own, so
# it needs to be told exactly where your server is.
#
# For testing on your phone while your server runs on your Mac, use your
# Mac's local network address (System Settings > Wi-Fi > Details > IP
# Address), for example:
# VITE_API_BASE_URL=http://192.168.1.23:5000/api
#
# For a real App Store submission, this must point to your server once
# it's deployed somewhere on the internet (not your laptop), for example:
# VITE_API_BASE_URL=https://your-deployed-server.com/api

VITE_API_BASE_URL=
